
{% assign metafield = product.metafields.reviews_product.data %}
{% assign rating = product.metafields.reviews.rating %}
{% assign rating_count = product.metafields.reviews.rating_count %}

<div>
  {{ rating }}
</div>
<script>
  Avada_Reviews = {
    customer: {% if customer %}
      {
        id: {{ customer.id | json }},
        firstName: {{ customer.first_name | json }},
        lastName: {{ customer.last_name | json }},
        email: {{ customer.email | json }},
        orders: {{ customer.orders_count | json }}
      }
    {% else %}
      null  
    {% endif %},

    product: {{ product | json }},

    productReview: {
      reviewSummary: 
        {% if metafield and metafield.value.reviewSummary %}
          {{ metafield.value.reviewSummary | json }}
        {% else %}
          {
            "five_star": {
              "published": 0,
              "unpublished": 0
            },
            "four_star": {
              "unpublished": 0,
              "published": 0
            },
            "three_star": {
              "unpublished": 0,
              "published": 0
            },
            "two_star": {
              "unpublished": 0,
              "published": 0
            },
            "one_star": {
              "unpublished": 0,
              "published": 0
            }
          }
        {% endif %},
      reviews: 
        {%  if metafield and metafield.value.reviews %}
          {{ metafield.value.reviews | json}}
        {% else %}
          []
        {% endif %},
      },

    rating: {% if rating.value %}
      {{ rating.value | t }}
    {% else %}
      0
    {% endif %},
    ratingCount: {% if rating_count.value %}
      {{ rating_count.value | t }}
    {% else %}
      0
    {% endif %}
  };
</script>




{% schema %}
{
  "name": "Product Reviews",
  "target": "body",
  "javascript": "avada-embed.js",
  "settings": []
}
{% endschema %}
