{% assign rating_str = product.metafields.reviews.rating.value | append: '' %}
{% assign avg_rating = rating_str | plus: 0 %}

{% assign count = product.metafields.reviews.rating_count %}
{% assign star_percent = avg_rating | times: 20 %}


{% if avg_rating > 0 and count > 0%}
  <div style="width: 100%">
    {% render 'stars', total: count, rating: avg_rating, star_percent:star_percent%}
  </div>
{% else %}
  <div style="width: 100%">
    {% render 'stars', total: 0, rating: 0 , star_percent: 0%}
  </div>
{% endif %}


  
{% schema %}
{
  "name": "Average Rating",
  "target": "section",
  "templates": ["product"],
  "stylesheet": "average-rating.css",
  "settings": []
}
{% endschema %}
